generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id            String   @id @default(cuid())
  name          String
  role          String
  tagline       String
  bio           String
  githubUsername String
  githubUrl     String
  contactEmail  String
  location      String?
  avatarUrl     String
  avatarSource  AvatarSource @default(GITHUB)
  updatedAt     DateTime @updatedAt
}

enum AvatarSource {
  GITHUB
  CUSTOM
}

model Service {
  id          String  @id @default(cuid())
  title       String
  description String
  order       Int     @default(0)
}

model Skill {
  id       String    @id @default(cuid())
  name     String
  category SkillCategory @default(SOFT)
  order    Int       @default(0)
}

enum SkillCategory {
  SOFT
  TECHNICAL
}

model Project {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  summary      String
  description  String
  role         String?
  techStack    String[]
  highlights   String[]
  repoUrl      String
  liveUrl      String?
  featured     Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  clicks       ProjectClick[]
}

// One row per page render. Used to power the traffic dashboard in /admin.
model PageView {
  id        String   @id @default(cuid())
  path      String
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
}

// One row per visit to a project's detail page — the "click" a project
// card produces when someone opens it from the projects grid.
model ProjectClick {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([createdAt])
}
