# Postgres connection string, e.g. from Render/Supabase/Neon/local
DATABASE_URL="postgresql://user:password@localhost:5432/portfolio_dev"

# Password for /admin — pick something strong. Required.
ADMIN_PASSWORD="change-me"

# Random long random string used to sign the admin session cookie. Required.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET="change-me-too"

# Optional — only read by the seed scripts (npm run db:seed /
# db:ensure-seed) to set the initial GitHub username/avatar. Defaults to
# "Emediong-Etuk" if unset. Has no effect after the first seed — change
# the GitHub username from /admin instead.
GITHUB_USERNAME="Emediong-Etuk"
